# ─── OpenAI API ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (optional) ──────────────────────────────────────────────────────
# Leave blank to use the in-memory store (no PostgreSQL required for dev/testing)
# DATABASE_URL=postgresql://agentflow:password@localhost:5432/agentflow

# ─── Mock Mode ────────────────────────────────────────────────────────────────
# true  = instant mock responses, no API key needed
# false = live mode (requires OPENAI_API_KEY + integration credentials below)
USE_MOCK_INTEGRATIONS=true

# ─── External integrations (only when USE_MOCK_INTEGRATIONS=false) ────────────
# SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com
# ZENDESK_SUBDOMAIN=your_subdomain
# MEETING_BASE_URL=https://your-meetings-provider.com
